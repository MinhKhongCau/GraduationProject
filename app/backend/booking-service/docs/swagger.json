                    "type": "integer",
                    "maximum": 30,
                    "minimum": 1
                },
                "expert_id": {
                    "type": "string"
                }
            }
        },
        "handler.UpdateAvailabilityRequest": {
            "type": "object",
            "properties": {
                "day_of_week": {
                    "type": "integer"
                },
                "effective_from": {
                    "type": "integer"
                },
                "effective_until": {
                    "type": "integer"
                },
                "is_enabled": {
                    "type": "boolean"
                },
                "template_id": {
                    "type": "string"
                }
            }
