                    "type": "string"
                }
            }
        },
        "handler.CreateAvailabilityRequest": {
            "type": "object",
            "required": [
                "day_of_week",
                "effective_from",
                "template_id"
            ],
            "properties": {
                "day_of_week": {
                    "description": "1=Mon...7=Sun",
                    "type": "integer",
                    "maximum": 7,
                    "minimum": 1
                },
                "effective_from": {
                    "description": "Unix ms",
                    "type": "integer"
                },
                "effective_until": {
                    "type": "integer"
                },
                "template_id": {
                    "type": "string"
                }
            }
        },
        "handler.CreateTemplateRequest": {
            "type": "object",
            "required": [
                "end_time",
                "shift_name",
                "slot_duration_minutes",
                "start_time"
            ],
            "properties": {
                "end_time": {
                    "description": "\"HH:MM\"",
                    "type": "string"
                },
                "shift_name": {
                    "type": "string"
                },
                "slot_duration_minutes": {
                    "type": "integer",
                    "maximum": 180,
                    "minimum": 10
                },
                "start_time": {
                    "description": "\"HH:MM\"",
                    "type": "string"
                }
            }
        },
        "handler.GenerateRequest": {
            "type": "object",
            "required": [
