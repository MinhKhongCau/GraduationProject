# Copy this file to .env.local and fill in values for your environment.
# All HTTP APIs are called through the Kong gateway. This value is bundled into
# browser and Capacitor WebView code, so never put credentials in it.
# Local web development uses the gateway on port 8000.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Release / remote Capacitor shell example:
# NEXT_PUBLIC_API_URL=https://api.myapp.example.com/api/v1

# chatroom-service's Socket.IO transport isn't proxied through Kong (only
# /api/v1/chatroom REST is gateway-wired) — connect directly to the service.
NEXT_PUBLIC_CHATROOM_WS_URL=http://localhost:8085

# Web-only Google OAuth (Google Identity Services client ID). For Capacitor
# native builds use a native Google Sign-In plugin; do not enable this web SDK.
# Google login also remains feature-flagged until the backend implements POST /auth/google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# When true, API calls for endpoints not yet implemented backend-side fall back to
# the mock data in /data instead of throwing (see DESIGN.md "mock fallback" section).
NEXT_PUBLIC_ENABLE_MOCKS=true

# Capacitor Remote Server Shell. Use CAPACITOR_ENV=production in CI/release
# builds and set these two URLs to your public HTTPS app and gateway domains.
CAPACITOR_ENV=development
CAPACITOR_DEV_SERVER_URL=http://localhost:3000
CAPACITOR_PRODUCTION_URL=https://myapp.example.com

REDIS_HOST=localhost
REDIS_PORT=6379
