# Copy this file to .env.local and fill in values for your environment.
# Each backend microservice is called directly (no API gateway yet).
# Ports below match .deploy/dev/.env — update if your local backend uses different ports.

NEXT_PUBLIC_AUTH_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_PROFILE_API_URL=http://localhost:8081/api/v1
NEXT_PUBLIC_PAYMENT_API_URL=http://localhost:8082/api/v1
NEXT_PUBLIC_BOOKING_API_URL=http://localhost:8083/api/v1
NEXT_PUBLIC_ASSESSMENT_API_URL=http://localhost:5000/api/v1

# Google OAuth (Google Identity Services client ID). Google login is feature-flagged
# because the backend does not implement POST /auth/google yet.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# When true, API calls for endpoints not yet implemented backend-side fall back to
# the mock data in /data instead of throwing (see DESIGN.md "mock fallback" section).
NEXT_PUBLIC_ENABLE_MOCKS=true

# Public URL of the deployed web app, used by capacitor.config.ts so the mobile
# shell loads the real site instead of a static export.
NEXT_PUBLIC_APP_URL=http://localhost:3000
